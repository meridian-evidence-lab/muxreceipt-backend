{
  "openapi": "3.1.0",
  "info": {
    "title": "MuxReceipt API",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4311"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Local application status",
        "responses": {
          "200": {
            "description": "Health"
          }
        }
      }
    },
    "/api/sample": {
      "get": {
        "summary": "Synthetic engine sample",
        "responses": {
          "200": {
            "description": "Input"
          }
        }
      }
    },
    "/api/audits": {
      "get": {
        "summary": "Recent audit history",
        "responses": {
          "200": {
            "description": "At most 100 summaries"
          }
        }
      },
      "post": {
        "summary": "Run and persist a normalized audit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Persisted audit"
          },
          "422": {
            "description": "Invalid normalized input"
          }
        }
      }
    },
    "/api/audits/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Input and report"
          },
          "404": {
            "description": "Missing"
          }
        }
      }
    },
    "/api/contracts/proposals": {
      "post": {
        "summary": "Build unsigned registry proposal; never submits a transaction",
        "responses": {
          "200": {
            "description": "Method, ABI args, and local proof"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mapping"
                ],
                "properties": {
                  "mapping": {
                    "type": "object"
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "salt": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/network": {
      "get": {
        "summary": "Read-only operator-configured RPC health",
        "responses": {
          "200": {
            "description": "Provider-reported network status"
          }
        }
      }
    },
    "/api/mappings": {
      "get": {
        "responses": {
          "200": {
            "description": "Saved normalized mapping list"
          }
        }
      },
      "put": {
        "responses": {
          "200": {
            "description": "Validated mappings saved"
          }
        }
      }
    },
    "/api/audits/{id}/html": {
      "get": {
        "summary": "Render stored audit with shared review package",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Static escaped HTML review",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Audit not found"
          }
        }
      }
    },
    "/api/contracts/verify": {
      "post": {
        "summary": "Verify a pinned testnet registry record via SDK ledger read",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scope",
                  "revision",
                  "expectedCommitment"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Record and executable match expected values"
          },
          "404": {
            "description": "Record unavailable or archived"
          },
          "409": {
            "description": "Network, executable or commitment mismatch"
          },
          "422": {
            "description": "Malformed input"
          },
          "503": {
            "description": "Testnet registry configuration missing"
          }
        }
      }
    }
  }
}
